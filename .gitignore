.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ultralytics/
# Only the reproducible COCO validation subset below is versioned through Git LFS.
# Training annotations and every other local dataset/cache stay outside the repository.
data/*
!data/coco/
data/coco/*
!data/coco/val2017/
!data/coco/val2017/**
!data/coco/annotations/
data/coco/annotations/*
!data/coco/annotations/instances_val2017.json
# Keep bulky intermediate runs local, but publish the compact final evidence set.
runs/*
!runs/coco_topic6_final_1000/
!runs/coco_topic6_final_1000/**
*.pt
*.onnx

